{
  "name": "tutoring-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "docx": "^9.15.4",
    "jose": "^6.2.15",
    "katex": "^0.19.1",
    "mathjax-full": "^3.2.1",
    "node-ical": "^0.27.1",
    "nodemailer": "10.2.1",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "node scripts/vendor-learning.mjs",
    "prebuild": "node scripts/vendor-learning.mjs",
    "test:learning": "node --test tests/unit/learning-experience.test.mjs tests/unit/learning-lifecycle.test.mjs tests/characterization/learning-experience.test.mjs tests/unit/presenter-notes.test.mjs tests/characterization/presenter-notes.test.mjs",
    "test:pilot:browser": "node tests/browser/visual-controls.mjs && node tests/browser/visual-pilot.mjs",
    "test:learning:browser": "node tests/browser/learning-experience.mjs",
    "test:workspace:browser": "node tests/browser/tutor-workspace.mjs",
    "learning:video": "node scripts/render-learning-video.mjs",
    "start": "node build/index.js",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:ci": "node scripts/check-warnings.mjs",
    "test:review:browser": "node tests/browser/learning-review.mjs",
    "test:ui:browser": "node tests/browser/apple-role-journeys.mjs",
    "test:auth:browser": "node tests/browser/google-onboarding.mjs",
    "test:qa": "playwright test --config playwright.qa.config.mjs",
    "test:qa:select": "node scripts/pr-qa/select.mjs",
    "test:qa:report": "node scripts/pr-qa/report.mjs",
    "test:teaching:browser": "node tests/browser/teaching-v2.mjs",
    "test:review:v2:browser": "REVIEW_VERSION=v2 node tests/browser/learning-review.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.4.0",
    "gsap": "^3.15.0",
    "hyperframes": "0.9.9",
    "lucide-static": "^1.41.0",
    "playwright-core": "^1.64.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "hyperframes": {
      "undici": "^7.30.1"
    },
    "pptxgenjs": {
      "image-size": "2.0.3"
    }
  }
}
