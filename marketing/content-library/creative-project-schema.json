{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["html","caption","alt_text","cta_category","timeline","math_assertions","claims_evidence","remote_assets"],
  "properties":{
    "html":{"type":"string","minLength":100,"maxLength":350000},
    "caption":{"type":"string","minLength":4,"maxLength":1000},
    "alt_text":{"type":"string","minLength":8,"maxLength":500},
    "cta_category":{"enum":["educational","booking","acquisition","waitlist","participation"]},
    "timeline":{"type":"array","minItems":2,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["start","end","action"],"properties":{"start":{"type":"number","minimum":0,"maximum":15},"end":{"type":"number","exclusiveMinimum":0,"maximum":15},"action":{"type":"string","minLength":2,"maxLength":80}}}},
    "math_assertions":{"type":"array","maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["expression","result"],"properties":{"expression":{"type":"string","maxLength":100},"result":{"type":"number"}}}},
    "claims_evidence":{"type":"array","maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["claim","evidence_id"],"properties":{"claim":{"type":"string","maxLength":200},"evidence_id":{"type":"string","maxLength":80}}}},
    "remote_assets":{"type":"array","maxItems":5,"items":{"type":"object","additionalProperties":false,"required":["url","license","purpose","path"],"properties":{"url":{"type":"string","maxLength":500},"license":{"type":"string","maxLength":120},"purpose":{"type":"string","maxLength":160},"path":{"type":"string","pattern":"^assets/remote-[1-5]\\.(png|jpe?g|webp)$"}}}}
  }
}
