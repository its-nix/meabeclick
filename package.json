{
  "name": "tutoring-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "katex": "^0.19.1",
    "node-ical": "^0.27.1",
    "nodemailer": "10.2.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "node scripts/vendor-learning.mjs",
    "prebuild": "node scripts/vendor-learning.mjs",
    "test:learning": "node --test tests/unit/learning-experience.test.mjs tests/unit/learning-lifecycle.test.mjs tests/characterization/learning-experience.test.mjs",
    "test:learning:browser": "node tests/browser/learning-experience.mjs",
    "test:workspace:browser": "node tests/browser/tutor-workspace.mjs",
    "learning:video": "node scripts/render-learning-video.mjs",
    "start": "node build/index.js",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:ci": "node scripts/check-warnings.mjs",
    "test:ui:browser": "node tests/browser/apple-role-journeys.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.4.0",
    "gsap": "^3.15.0",
    "hyperframes": "0.9.9",
    "lucide-static": "^1.41.0",
    "playwright-core": "^1.64.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "hyperframes": {
      "undici": "^7.30.1"
    }
  }
}
